#!/usr/bin/env bash
set -euo pipefail

SOLAR_VERSION="0.23.1"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=update_notice.sh
source "$SCRIPT_DIR/update_notice.sh"

usage() {
  cat <<EOF
Solar $SOLAR_VERSION

Usage:
  solar <subcommand>

Subcommands:
  setup                    Onboarding
  uninstall                Remove the local installation
  client init|sync|doctor|upgrade|update|bundle|self-update
  update                   Alias for: solar client update
  workspace doctor         Workspace content health
  app start|stop|status|open   Read-only console on :9000
  app workspace ...        Workspace registry helpers
  status [--verbose] [--json] [--strict]
  paths                    Resolvable paths for IDE references
  mcp                      Stdio MCP server (what an IDE launches)
  mcp print|install|uninstall  User-level snippets / merge into Cursor, Claude, Codex
  -v, --version            Show version
  -h, --help               Show help
EOF
}

# Version / help must work without a workspace or Solar App runtime.
case "${1:-}" in
  -v|--version)
    echo "solar $SOLAR_VERSION"
    exit 0
    ;;
  ""|-h|--help)
    solar_update_notice_print "$SOLAR_VERSION" || true
    usage
    exit 0
    ;;
esac

CLIENT_SCRIPTS="$SCRIPT_DIR"
WORKSPACE_SCRIPTS="$(cd "$SCRIPT_DIR/../../solar-workspace/scripts" && pwd)"
APP_SCRIPTS="$(cd "$SCRIPT_DIR/../../solar-app/scripts" && pwd)"

# Workspace / client / console commands
case "${1:-}" in
  setup)
    shift
    exec bash "$CLIENT_SCRIPTS/solar_setup.sh" "$@"
    ;;
  uninstall)
    shift
    exec bash "$CLIENT_SCRIPTS/uninstall_solar_client.sh" "$@"
    ;;
  client)
    shift
    case "${1:-}" in
      init)
        shift
        exec bash "$CLIENT_SCRIPTS/client_init.sh" "$@"
        ;;
      sync)
        shift
        exec bash "$CLIENT_SCRIPTS/client_sync.sh" "$@"
        ;;
      doctor)
        shift
        exec bash "$CLIENT_SCRIPTS/client_doctor.sh" "$@"
        ;;
      upgrade)
        shift
        exec bash "$CLIENT_SCRIPTS/client_upgrade.sh" "$@"
        ;;
      update)
        shift
        exec bash "$CLIENT_SCRIPTS/client_update.sh" "$@"
        ;;
      bundle)
        shift
        exec bash "$CLIENT_SCRIPTS/client_bundle.sh" "$@"
        ;;
      self-update)
        shift
        exec bash "$CLIENT_SCRIPTS/client_self_update.sh" "$@"
        ;;
      "")
        echo "Usage: solar client {init|sync|doctor|upgrade|update|bundle|self-update}" >&2
        exit 2
        ;;
      *)
        echo "Unknown client subcommand: $1" >&2
        exit 2
        ;;
    esac
    ;;
  workspace)
    shift
    case "${1:-}" in
      doctor)
        shift
        exec bash "$WORKSPACE_SCRIPTS/workspace_doctor.sh" "$@"
        ;;
      "")
        echo "Usage: solar workspace {doctor}" >&2
        exit 2
        ;;
      *)
        echo "Unknown workspace subcommand: $1" >&2
        exit 2
        ;;
    esac
    ;;
  app)
    shift
    case "${1:-}" in
      start)
        shift
        exec bash "$APP_SCRIPTS/start_host.sh" "$@"
        ;;
      stop)
        shift
        exec bash "$APP_SCRIPTS/stop_host.sh" "$@"
        ;;
      status)
        shift
        exec bash "$APP_SCRIPTS/check_host.sh" "$@"
        ;;
      open)
        _host_url="$(bash -c "source \"$APP_SCRIPTS/host_lib.sh\" && solar_host_load_env && printf '%s' \"\$SOLAR_APP_BASE_URL\"")"
        if command -v open >/dev/null 2>&1; then
          open "$_host_url"
        else
          echo "Open: $_host_url"
        fi
        exit 0
        ;;
      workspace)
        shift
        exec bash "$APP_SCRIPTS/host_workspace.sh" "$@"
        ;;
      "")
        echo "Usage: solar app {start|stop|status|open|workspace ...}" >&2
        exit 2
        ;;
      *)
        echo "Unknown app subcommand: $1" >&2
        exit 2
        ;;
    esac
    ;;
  status)
    shift
    exec bash "$SCRIPT_DIR/solar_status.sh" "$@"
    ;;
  paths)
    shift
    exec bash "$SCRIPT_DIR/solar_paths.sh" "$@"
    ;;
  mcp)
    shift
    MCP_SCRIPTS="$(cd "$SCRIPT_DIR/../../solar-mcp/scripts" && pwd)"
    exec "${SOLAR_MCP_PYTHON:-python3}" "$MCP_SCRIPTS/mcp_cli.py" "$@"
    ;;
  update)
    # Alias: users often type `solar update` for client update (not chat).
    shift
    exec bash "$CLIENT_SCRIPTS/client_update.sh" "$@"
    ;;
  *)
    echo "Unknown command: $1. Use solar --help." >&2
    exit 2
    ;;
esac
