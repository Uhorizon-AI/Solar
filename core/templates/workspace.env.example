# Solar workspace — copy to .env and adjust. Do not commit .env.

# [solar-app]
SOLAR_APP_HOST=127.0.0.1
SOLAR_APP_PORT=9000
SOLAR_APP_RUNTIME_DIR=sun/runtime/app

# [solar-router]
SOLAR_ROUTER_RUNTIME_DIR=sun/runtime/router
SOLAR_ROUTER_PROVIDER_PRIORITY=codex,claude,gemini

# [solar-system]
SOLAR_SYSTEM_FEATURES=host,async-tasks

# [solar-gateway] (optional; legacy block header may read solar-transport-gateway)
# SOLAR_HTTP_PORT=8787
