# Solar workspace — copy to .env and adjust. Do not commit .env.

# Machine state lives outside the workspace, under the framework runtime root
# (macOS: ~/Library/Application Support/Solar/runtime). Set SOLAR_RUNTIME_ROOT
# only for an explicit deployment; there is no fallback to sun/runtime.
# SOLAR_RUNTIME_ROOT=

# [solar-app]
SOLAR_APP_HOST=127.0.0.1
SOLAR_APP_PORT=9000

# [solar-router]
SOLAR_ROUTER_PROVIDER_PRIORITY=codex,claude,agy,agent

# [solar-system]
SOLAR_SYSTEM_FEATURES=host,async-tasks

# [solar-gateway] (optional; legacy block header may read solar-transport-gateway)
# SOLAR_HTTP_PORT=8787
